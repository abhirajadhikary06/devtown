# Backend (copy to backend/.env)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=https://your-domain
FRONTEND_URL=https://your-domain
COOKIE_SECURE=true

# Optional: a GitHub PAT (read:user / public read) used to seed the rotating showcase
# cities from public profiles. If empty, seeding falls back to a stored login token
# (log in once via Connect GitHub). Leave blank to skip showcase seeding.
GITHUB_SEED_TOKEN=
GITHUB_README_TOKEN=
GITHUB_README_REPOSITORY=
